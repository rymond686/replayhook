# Public site origin used in sitemap, robots.txt, llms.txt, and security.txt.
# Leave as localhost for local review. Set to the real https:// origin before any deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. When unset, the first-phase demo, inspector, and unit tests
# run entirely on in-repo synthetic data and do not need a database.
# Use the official Supabase project URL and anon (or publishable) key
# when you are ready to persist analytics and pilot applications.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional service-role key for the worker process only. Never expose this
# to the browser or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=

# GitHub Pages static preview (set only for that build):
# GITHUB_PAGES=true
# NEXT_PUBLIC_BASE_PATH=/replayhook
# NEXT_PUBLIC_SITE_URL=https://rymond686.github.io/replayhook

# Public URL of the first-party analytics collector (Supabase Edge Function).
# This is an endpoint URL, not a secret. Required for the GitHub Pages build
# so the static site can persist sanitized funnel events.
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://<project-ref>.supabase.co/functions/v1/track
#
# Optional publishable key only if the platform gateway requires `apikey`.
# Never put a service_role or secret key in a NEXT_PUBLIC_ variable.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
