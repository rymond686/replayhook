# Public site origin used in sitemap, robots.txt, llms.txt, and security.txt.
# Leave as localhost for local review. Set to the real https:// origin before any deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. When unset, the first-phase demo, inspector, and unit tests
# run entirely on in-repo synthetic data and do not need a database.
# Use the official Supabase project URL and anon (or publishable) key
# when you are ready to persist analytics and pilot applications.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional service-role key for the worker process only. Never expose this
# to the browser or commit it to git.
SUPABASE_SERVICE_ROLE_KEY=
